/**
  * @brief  页面3: 上下滚动文字演示
  * @note   掌握上下滚动显示方式
  */
static void Demo_ScrollText(void)
{
  int16_t y_offset;
  const char *lines[] = {
    "Line 1: Hello U8G2!",
    "Line 2: STM32 OLED",
    "Line 3: I2C 400kHz",
    "Line 4: SSD1306",
    "Line 5: 128x64 px",
    "Line 6: HAL Driver",
    "Line 7: Scroll Demo",
    "Line 8: Have Fun!"
  };
  const uint8_t line_count = 8;
  const uint8_t line_height = 12;

  /* ---- 向上滚动 ---- */
  for (y_offset = 64; y_offset > -(line_count * line_height); y_offset -= 2)
  {
    u8g2_ClearBuffer(&u8g2);
    u8g2_SetFont(&u8g2, u8g2_font_6x10_tf);

    uint8_t i;
    for (i = 0; i < line_count; i++)
    {
      int16_t y = y_offset + i * line_height;
      if (y > -line_height && y < 64 + line_height)
      {
        u8g2_DrawStr(&u8g2, 4, y + 10, lines[i]);
      }
    }

    /* 顶部和底部渐变遮罩效果 */
    u8g2_SetDrawColor(&u8g2, 0);
    u8g2_DrawBox(&u8g2, 0, 0, 128, 2);
    u8g2_DrawBox(&u8g2, 0, 62, 128, 2);
    u8g2_SetDrawColor(&u8g2, 1);

    /* 左右边框 */
    u8g2_DrawVLine(&u8g2, 0, 0, 64);
    u8g2_DrawVLine(&u8g2, 127, 0, 64);

    u8g2_SendBuffer(&u8g2);
    HAL_Delay(30);  /* 控制滚动速度 */
  }

  /* ---- 向下滚动回来 ---- */
  for (y_offset = -(line_count * line_height); y_offset <= 8; y_offset += 2)
  {
    u8g2_ClearBuffer(&u8g2);
    u8g2_SetFont(&u8g2, u8g2_font_6x10_tf);

    uint8_t i;
    for (i = 0; i < line_count; i++)
    {
      int16_t y = y_offset + i * line_height;
      if (y > -line_height && y < 64 + line_height)
      {
        u8g2_DrawStr(&u8g2, 4, y + 10, lines[i]);
      }
    }

    u8g2_SetDrawColor(&u8g2, 0);
    u8g2_DrawBox(&u8g2, 0, 0, 128, 2);
    u8g2_DrawBox(&u8g2, 0, 62, 128, 2);
    u8g2_SetDrawColor(&u8g2, 1);
    u8g2_DrawVLine(&u8g2, 0, 0, 64);
    u8g2_DrawVLine(&u8g2, 127, 0, 64);

    u8g2_SendBuffer(&u8g2);
    HAL_Delay(30);
  }
}

/**
  * @brief  页面4: 弹跳球动画 (动态图案)
  */
static void Demo_AnimateBall(void)
{
  uint16_t frame;

  ball_x = 10; ball_y = 30;
  ball_dx = 2;  ball_dy = 1;

  for (frame = 0; frame < 200; frame++)  /* 约200帧 */
  {
    u8g2_ClearBuffer(&u8g2);

    /* 边框 */
    u8g2_DrawFrame(&u8g2, 0, 0, 128, 64);

    /* 更新球位置 */
    ball_x += ball_dx;
    ball_y += ball_dy;

    /* 边界碰撞检测 */
    if (ball_x <= 5 || ball_x >= 122) ball_dx = -ball_dx;
    if (ball_y <= 5 || ball_y >= 58)  ball_dy = -ball_dy;

    /* 画球(实心圆) */
    u8g2_DrawDisc(&u8g2, ball_x, ball_y, 4, U8G2_DRAW_ALL);

    /* 拖尾效果 - 画小点 */
    u8g2_DrawPixel(&u8g2, ball_x - ball_dx, ball_y - ball_dy);
    u8g2_DrawPixel(&u8g2, ball_x - 2*ball_dx, ball_y - 2*ball_dy);

    /* 标题 */
    u8g2_SetFont(&u8g2, u8g2_font_5x7_tf);
    u8g2_DrawStr(&u8g2, 30, 10, "Bouncing Ball");

    u8g2_SendBuffer(&u8g2);
    HAL_Delay(20);
  }
}

/**
  * @brief  页面5: 旋转线条 + 星星位图 动态图案
  */
static void Demo_DynamicPattern(void)
{
  uint16_t angle;
  int16_t cx = 32, cy = 32;

  for (angle = 0; angle < 360; angle += 3)
  {
    u8g2_ClearBuffer(&u8g2);

    /* ---- 旋转线条 (简易模拟旋转) ---- */
    /* 使用查表法近似 sin/cos (避免浮点运算) */
    /* sin(angle) * 25, cos(angle) * 25 */
    int16_t a = angle % 360;
    int16_t x1, y1, x2, y2;

    /* 简易整数三角函数近似 (用分段线性) */
    /* 主线 */
    if (a < 90) {
      x1 = cx + (a * 25 / 90);
      y1 = cy - 25 + (a * 25 / 90);
    } else if (a < 180) {
      x1 = cx + 25 - ((a - 90) * 25 / 90);
      y1 = cy + ((a - 90) * 25 / 90);
    } else if (a < 270) {
      x1 = cx - ((a - 180) * 25 / 90);
      y1 = cy + 25 - ((a - 180) * 25 / 90);
    } else {
      x1 = cx - 25 + ((a - 270) * 25 / 90);
      y1 = cy - ((a - 270) * 25 / 90);
    }

    x2 = 2 * cx - x1;
    y2 = 2 * cy - y1;

    u8g2_DrawLine(&u8g2, x1, y1, x2, y2);

    /* 十字装饰线 */
    u8g2_DrawLine(&u8g2, cx - 3, cy, cx + 3, cy);
    u8g2_DrawLine(&u8g2, cx, cy - 3, cx, cy + 3);

    /* 外圆 */
    u8g2_DrawCircle(&u8g2, cx, cy, 28, U8G2_DRAW_ALL);

    /* ---- 右侧: 星星位图 + 闪烁效果 ---- */
    if ((angle / 15) % 2 == 0)
    {
      u8g2_DrawXBM(&u8g2, 80, 8, 16, 16, bitmap_star);
    }
    u8g2_DrawXBM(&u8g2, 100, 24, 16, 16, bitmap_smiley);

    /* ---- 右侧文字 ---- */
    u8g2_SetFont(&u8g2, u8g2_font_5x7_tf);
    u8g2_DrawStr(&u8g2, 72, 56, "Dynamic!");

    /* ---- 底部进度条 ---- */
    u8g2_DrawFrame(&u8g2, 0, 60, 64, 4);
    u8g2_DrawBox(&u8g2, 0, 60, (uint16_t)(angle * 64 / 360), 4);

    u8g2_SendBuffer(&u8g2);
    HAL_Delay(20);
  }
}

