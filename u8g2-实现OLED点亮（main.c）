/**
  * @brief  页面1: U8G2 Demo - Logo + 基本图形展示
  */
static void Demo_DrawLogo(void)
{
  uint8_t i;

  for (i = 0; i < 3; i++)   /* 展示3秒 */
  {
    u8g2_ClearBuffer(&u8g2);

    /* 标题 */
    u8g2_SetFont(&u8g2, u8g2_font_ncenB14_tr);
    u8g2_DrawStr(&u8g2, 10, 18, "U8G2 Demo");

    /* 分割线 */
    u8g2_DrawHLine(&u8g2, 0, 22, 128);

    /* 基本图形展示 */
    u8g2_DrawCircle(&u8g2, 16, 44, 12, U8G2_DRAW_ALL);      /* 圆 */
    u8g2_DrawFrame(&u8g2, 36, 32, 24, 24);                    /* 矩形框 */
    u8g2_DrawTriangle(&u8g2, 80, 56, 92, 32, 104, 56);       /* 三角形 */
    u8g2_DrawDisc(&u8g2, 116, 44, 8, U8G2_DRAW_ALL);         /* 实心圆 */

    /* 底部信息 */
    u8g2_SetFont(&u8g2, u8g2_font_5x7_tf);
    u8g2_DrawStr(&u8g2, 0, 63, "STM32F103+SSD1306 I2C");

    u8g2_SendBuffer(&u8g2);
    HAL_Delay(1000);
  }
}

