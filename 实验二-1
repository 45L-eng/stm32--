/**
  * @brief  串口接收完成回调：每收到1个字节自动进入一次
  * @param  huart: 触发中断的串口句柄
  */
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
  if (huart->Instance == USART1)            /* 确认中断来自串口1 */
  {
    if (rx_byte == '#')                     /* 收到'#'：暂停发送 */
    {
      g_tx_enable = 0;
    }
    else if (rx_byte == '*')                /* 收到'*'：恢复发送 */
    {
      g_tx_enable = 1;
    }
    HAL_UART_Receive_IT(&huart1, &rx_byte, 1);  /* 重新开启接收中断，准备收下一字节 */
  }
}

