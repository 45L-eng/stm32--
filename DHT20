/* ============================ 字符串拼装小工具 ============================ */

/**
  * @brief  把浮点数格式化为十进制字符串（不依赖 printf 的浮点支持）
  * @note   先整体四舍五入到 dec 位小数，再拆整数 / 小数部分，
  *         这样 25.96 会正确进位成 "26.0"，而不会被截断成 "25.0"。
  */
static char *FmtFloat(char *buf, float val, uint8_t dec)
{
    static const int32_t pow10[4] = {1, 10, 100, 1000};
    int32_t scale, scaled, ip, fp;
    int8_t  i, j;
    char   *p = buf;
    char    tmp[12];
    uint8_t neg;

    scale  = pow10[dec];
    neg    = (val < 0.0f) ? 1U : 0U;
    if (neg != 0U) { val = -val; }

    scaled = (int32_t)(val * (float)scale + 0.5f);   /* 放大后四舍五入 */
    if (scaled == 0) { neg = 0U; }                   /* 不输出 "-0.0" */

    if (neg != 0U) { *p++ = '-'; }
    fp = scaled % scale;
    ip = scaled / scale;

    i = 0;
    if (ip == 0) { tmp[i++] = '0'; }
    while (ip > 0)
    {
        tmp[i++] = (char)('0' + (ip % 10));
        ip /= 10;
    }
    while (i > 0) { *p++ = tmp[--i]; }

    if (dec > 0U)
    {
        int32_t d = scale;
        *p++ = '.';
        for (j = (int8_t)dec - 1; j >= 0; j--)
        {
            d /= 10;
            *p++ = (char)('0' + (fp / d) % 10);
        }
    }
    *p = '\0';
    return buf;
}

/**
  * @brief  把 src 追加到 dst 末尾（dst 必须有足够空间）
  */
static void AppendStr(char *dst, const char *src)
{
    while (*dst != '\0') { dst++; }
    while (*src != '\0') { *dst++ = *src++; }
    *dst = '\0';
}

/**
  * @brief  追加无符号整数，右对齐到 width 列，不足补 pad
  */
static void AppendU32(char *dst, uint32_t val, uint8_t width, char pad)
{
    char   tmp[12];
    char  *p = dst;
    int8_t i = 0;
    int8_t n;

    while (*p != '\0') { p++; }

    if (val == 0U) { tmp[i++] = '0'; }
    while (val > 0U)
    {
        tmp[i++] = (char)('0' + (val % 10U));
        val /= 10U;
    }
    n = i;
    while (n < (int8_t)width) { *p++ = pad; n++; }
    while (i > 0) { *p++ = tmp[--i]; }
    *p = '\0';
}

/**
  * @brief  追加 1 位（或 dec 位）小数的浮点数，右对齐到 width 列
  */
static void AppendF(char *dst, float val, uint8_t dec, uint8_t width)
{
    char    tmp[16];
    char   *p = dst;
    uint8_t len;
    uint8_t k;

    (void)FmtFloat(tmp, val, dec);

    while (*p != '\0') { p++; }
    len = (uint8_t)strlen(tmp);
    while (len < width) { *p++ = ' '; len++; }
    for (k = 0U; tmp[k] != '\0'; k++) { *p++ = tmp[k]; }
    *p = '\0';
}

/**
  * @brief  把毫秒数格式化成 HH:MM:SS 并追加到 dst
  */
static void AppendUptime(char *dst, uint32_t ms)
{
    uint32_t s = ms / 1000U;

    AppendU32(dst, (s / 3600U) % 100U, 2U, '0');
    AppendStr(dst, ":");
    AppendU32(dst, (s / 60U) % 60U, 2U, '0');
    AppendStr(dst, ":");
    AppendU32(dst, s % 60U, 2U, '0');
}

/**
  * @brief  根据温湿度给一个粗略的舒适度标签
  * @note   纯阈值判断，不使用 math 库，逻辑简单直观
  */
static const char *ComfortTag(float t, float h)
{
    if (h < 30.0f) { return "VERY DRY"; }
    if (h < 40.0f) { return "DRY";      }
    if (h > 75.0f) { return "WET";      }
    if (h > 65.0f) { return "HUMID";    }
    if (t < 18.0f) { return "COOL";     }
    if (t > 28.0f) { return "HOT";      }
    return "COMFORT";
}

/* ============================== 串口输出 ============================== */

/**
  * @brief  通过 USART1 发送一个字符串（阻塞方式，超时 100ms）
  */
static void UartSend(const char *str)
{
    HAL_UART_Transmit(&huart1, (uint8_t *)str, (uint16_t)strlen(str), 100U);
}

/**
  * @brief  打印开机横幅：把板子当前的硬件配置一次性交代清楚
  */
static void PrintBanner(void)
{
    UartSend("\r\n");
    UartSend("================================================================\r\n");
    UartSend("  STM32F103C8 | DHT20 / AHT20 ENVIRONMENT MONITOR\r\n");
    UartSend("  FW v2.1     | SYSCLK 64 MHz (HSI)  Flash 64 KB\r\n");
    UartSend("  I2C1        | PB8=SCL PB9=SDA  100 kHz  7-bit 0x38\r\n");
    UartSend("  USART1      | PB6=TX  PB7=RX   115200 8-N-1\r\n");
    UartSend("  LED         | PA0 heartbeat 500 ms\r\n");
    UartSend("================================================================\r\n");
}

/**
  * @brief  打印数据表格的表头
  */
static void PrintTableHeader(void)
{
    UartSend("----------------------------------------------------------------\r\n");
    UartSend("    #  UPTIME     TEMP(C)    HUMI(%)   COMFORT\r\n");
    UartSend("----------------------------------------------------------------\r\n");
}

/**
  * @brief  打印一行采样数据
  * @note   列宽与表头一一对应：
  *           序号 3 列右对齐 / 运行时间 8 列 / 温度 7 列右对齐 /
  *           湿度 7 列右对齐 / 舒适度左对齐
  */
static void PrintRow(uint32_t idx, uint32_t uptime_ms, float t, float h)
{
    msg[0] = '\0';
    AppendStr(msg, "  ");
    AppendU32(msg, idx, 3U, ' ');
    AppendStr(msg, "  ");
    AppendUptime(msg, uptime_ms);
    AppendStr(msg, "   ");
    AppendF(msg, t, 1U, 7U);
    AppendStr(msg, "    ");
    AppendF(msg, h, 1U, 7U);
    AppendStr(msg, "   ");
    AppendStr(msg, ComfortTag(t, h));
    AppendStr(msg, "\r\n");
    UartSend(msg);
}

/**
  * @brief  打印统计行：采样次数、失败次数、温湿度极值
  */
static void PrintStat(void)
{
    msg[0] = '\0';
    AppendStr(msg, "[STAT] ok=");
    AppendU32(msg, sample_no, 0U, ' ');
    AppendStr(msg, "  fail=");
    AppendU32(msg, fail_cnt, 0U, ' ');
    AppendStr(msg, "  T=");
    AppendF(msg, t_min, 1U, 0U);
    AppendStr(msg, "..");
    AppendF(msg, t_max, 1U, 0U);
    AppendStr(msg, " C   H=");
    AppendF(msg, h_min, 1U, 0U);
    AppendStr(msg, "..");
    AppendF(msg, h_max, 1U, 0U);
    AppendStr(msg, " %\r\n");
    UartSend(msg);
}

