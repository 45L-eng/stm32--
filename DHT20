/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */
  GPIO_InitTypeDef gpio_led = {0};

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_I2C1_Init();
  MX_USART1_UART_Init();
  /* USER CODE BEGIN 2 */

  /* ---- 心跳灯：PA0 推挽输出，低电平点亮 ---- */
  __HAL_RCC_GPIOA_CLK_ENABLE();
  gpio_led.Pin   = GPIO_PIN_0;
  gpio_led.Mode  = GPIO_MODE_OUTPUT_PP;
  gpio_led.Pull  = GPIO_NOPULL;
  gpio_led.Speed = GPIO_SPEED_FREQ_LOW;
  HAL_GPIO_Init(GPIOA, &gpio_led);

  /* ---- 运行状态清零 ---- */
  tick_led    = HAL_GetTick();
  tick_send   = HAL_GetTick();
  sample_no   = 0U;
  fail_cnt    = 0U;
  have_minmax = 0U;

  /* ---- 开机自检：横幅 -> 探测传感器 -> 表头 ---- */
  PrintBanner();
  UartSend("[BOOT ] firmware start, self-test ...\r\n");

  UartSend("[PROBE] sensor 0x38 ......... ");
  aht20_ok = (AHT20_Init() == 0U) ? 1U : 0U;
  UartSend((aht20_ok != 0U) ? "OK\r\n" : "NO ACK\r\n");

  if (aht20_ok == 0U)
  {
    UartSend("[WARN ] sensor offline, check PB8=SCL PB9=SDA 3V3 GND\r\n");
  }

  PrintTableHeader();
  UartSend("[READY] sampling every 2 s\r\n");

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */

    /* ---- 心跳：每 500ms 翻转 PA0，灯停止闪烁说明程序卡死 ---- */
    if ((HAL_GetTick() - tick_led) >= HEARTBEAT_MS)
    {
      tick_led = HAL_GetTick();
      HAL_GPIO_TogglePin(GPIOA, GPIO_PIN_0);
    }

    /* ---- 每 2 秒采集一次 ---- */
    if ((HAL_GetTick() - tick_send) >= SAMPLE_PERIOD_MS)
    {
      tick_send = HAL_GetTick();

      if (aht20_ok != 0U)
      {
        if (AHT20_Read(&t_val, &h_val) == 0U)
        {
          /* 成功：更新计数与极值，然后输出一行 */
          sample_no++;

          if (have_minmax == 0U)
          {
            t_min = t_val; t_max = t_val;
            h_min = h_val; h_max = h_val;
            have_minmax = 1U;
          }
          else
          {
            if (t_val < t_min) { t_min = t_val; }
            if (t_val > t_max) { t_max = t_val; }
            if (h_val < h_min) { h_min = h_val; }
            if (h_val > h_max) { h_max = h_val; }
          }

          PrintRow(sample_no, HAL_GetTick(), t_val, h_val);

          if ((sample_no % SAMPLES_PER_STAT) == 0U) { PrintStat(); }
        }
        else
        {
          /* 失败：AHT20_Read 内部已经做过 I2C 总线恢复，这里重新探测一次 */
          fail_cnt++;
          msg[0] = '\0';
          AppendStr(msg, "[WARN ] read timeout, fail=");
          AppendU32(msg, fail_cnt, 0U, ' ');
          AppendStr(msg, " -> re-probing\r\n");
          UartSend(msg);

          aht20_ok = (AHT20_Init() == 0U) ? 1U : 0U;

          if (aht20_ok != 0U)
          {
            UartSend("[INFO ] sensor back online\r\n");
            PrintTableHeader();
          }
          else
          {
            UartSend("[FAIL ] sensor offline\r\n");
          }
        }
      }
      else
      {
        /* 离线状态：每 2 秒重试一次探测 */
        aht20_ok = (AHT20_Init() == 0U) ? 1U : 0U;

        if (aht20_ok != 0U)
        {
          UartSend("[INFO ] sensor online, resume sampling\r\n");
          PrintTableHeader();
        }
        else
        {
          fail_cnt++;
          msg[0] = '\0';
          AppendStr(msg, "[FAIL ] sensor offline, retry #");
          AppendU32(msg, fail_cnt, 0U, ' ');
          AppendStr(msg, "  check PB8/PB9/3V3/GND\r\n");
          UartSend(msg);
        }
      }
    }

  }
  /* USER CODE END 3 */
}

